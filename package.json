{
  "name": "@prosodyai/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for diarized conversations, vocal acoustics, speaker-relative change, and speaker identity",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProsodyAI/sdk.git"
  },
  "homepage": "https://prosodyai.app/docs",
  "bugs": {
    "url": "https://github.com/ProsodyAI/sdk/issues"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "npx --yes serve . -p 3000",
    "prepack": "npm run build"
  },
  "keywords": [
    "prosodyai",
    "prosody",
    "speech",
    "audio-analysis",
    "diarization",
    "acoustics",
    "speaker-identity",
    "typescript"
  ],
  "author": {
    "name": "ProsodyAI",
    "url": "https://prosodyai.app"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
